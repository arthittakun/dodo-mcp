{
  "name": "dodo-mcp",
  "version": "1.3.1",
  "author": "Arthittakun",
  "description": "DODO — local-first MCP server with multi-project coding, AI providers, sub-agents, context, memory, media and workflow tools; embedded OAuth and workspace permissions.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "dodo": "dist/cli/main.js",
    "dodo-media-setup": "scripts/setup-multimodal.mjs"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "schemas",
    "examples",
    "docs/ARCHITECTURE.md",
    "docs/ASSISTANCE.md",
    "docs/AGENT_RUNTIME.md",
    "docs/AI_PROVIDERS.md",
    "docs/ANDROID.md",
    "docs/AUTH.md",
    "docs/BRAIN.md",
    "docs/CI.md",
    "docs/COMPATIBILITY.md",
    "docs/CONTEXT.md",
    "docs/CONFIRMATION.md",
    "docs/DESKTOP.md",
    "docs/EVALUATION.md",
    "docs/LARGE_INPUTS.md",
    "docs/LSP.md",
    "docs/MANUAL_ACCEPTANCE.md",
    "docs/MEMORY.md",
    "docs/MULTIMODAL.md",
    "docs/PROJECTS.md",
    "docs/RECOVERY.md",
    "docs/RESOURCES.md",
    "docs/RUNTIME.md",
    "docs/RELEASE_1.0.0.md",
    "docs/RELEASE_1.0.1.md",
    "docs/RELEASE_1.0.2.md",
    "docs/RELEASE_1.0.3.md",
    "docs/RELEASE_1.0.4.md",
    "docs/RELEASE_1.0.5.md",
    "docs/RELEASE_1.0.6.md",
    "docs/RELEASE_1.1.0.md",
    "docs/RELEASE_1.2.0.md",
    "docs/RELEASE_1.2.1.md",
    "docs/RELEASE_1.3.0.md",
    "docs/RELEASE_1.3.1.md",
    "docs/RELEASE_NOTES.md",
    "docs/SCHEDULES.md",
    "docs/SECURITY.md",
    "docs/TEST_REPORT.md",
    "docs/TUNNEL.md",
    "docs/MCP_CONNECTIONS.md",
    "docs/WEB_CLIENTS.md",
    "docs/WINDOWS.md",
    "docs/WINDOWS_SETUP.md",
    "docs/adr",
    "README.md",
    "LICENSE",
    "native",
    "scripts/setup-multimodal.mjs",
    "scripts/guard-publish.mjs"
  ],
  "scripts": {
    "build": "node scripts/clean-build-artifacts.mjs && tsc -p tsconfig.build.json && node scripts/emit-schemas.mjs && node scripts/vendor-ui.mjs && node scripts/copy-ui.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests scripts",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:compat": "vitest run tests/compatibility",
    "test:pack": "vitest run tests/packaging",
    "test:bench": "node scripts/dodo-bench.mjs",
    "test:linux:docker": "node scripts/test-linux-docker.mjs",
    "bench": "npm run build && node scripts/dodo-bench.mjs",
    "test:windows": "vitest run tests/unit/windowsPlatform.test.ts tests/unit/windowsAclContract.test.ts tests/integration/windowsRuntime.test.ts tests/security/windowsNative.test.ts tests/security/windowsAclOwner.test.ts tests/security/ipcAuthentication.test.ts tests/security/rollbackPathPolicy.test.ts",
    "test:all": "npm run typecheck && npm run lint && vitest run tests/unit tests/integration tests/security tests/compatibility && npm run test:pack",
    "release:gate": "node scripts/release-gate.mjs --allow-dirty",
    "release:gate:ci": "node scripts/release-gate.mjs",
    "ci:windows:focus": "node scripts/windows-focus.mjs",
    "release:gate:strict": "node scripts/release-gate.mjs --release",
    "prepublishOnly": "node scripts/guard-publish.mjs",
    "desktop:setup": "node dist/cli/main.js desktop setup",
    "multimodal:setup": "node scripts/setup-multimodal.mjs",
    "test:desktop:native": "npm run build && node scripts/test-desktop-native.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "better-sqlite3": "13.0.3",
    "commander": "15.0.0",
    "cron-parser": "5.10.0",
    "diff": "^9.0.0",
    "express": "5.2.1",
    "ignore": "^7.0.9",
    "jose": "6.2.12",
    "oidc-provider": "9.12.2",
    "picomatch": "^4.0.7",
    "playwright": "1.63.0",
    "sharp": "0.35.4",
    "tar-stream": "3.2.1",
    "typescript": "5.9.3",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/oidc-provider": "^9.12.1",
    "@types/picomatch": "^4.0.3",
    "eslint": "^9.39.0",
    "pyright": "^1.1.413",
    "sweetalert2": "11.26.25",
    "typescript-eslint": "^8.70.0",
    "vitest": "5.0.0"
  },
  "keywords": [
    "dodo",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "coding-tools",
    "ai-coding",
    "developer-tools",
    "local-first",
    "stdio",
    "oauth",
    "chatgpt",
    "codex",
    "typescript",
    "semantic-search",
    "project-memory",
    "code-editing",
    "parallel-jobs",
    "cron",
    "scheduled-tasks",
    "owner-consent",
    "multimodal",
    "browser-automation",
    "video",
    "speech-to-text",
    "workflow",
    "android",
    "adb"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthittakun/dodo-mcp.git"
  },
  "homepage": "https://github.com/arthittakun/dodo-mcp#readme",
  "bugs": {
    "url": "https://github.com/arthittakun/dodo-mcp/issues"
  },
  "optionalDependencies": {
    "@img/sharp-wasm32": "0.35.4"
  }
}
