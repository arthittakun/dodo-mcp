{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "exclude": {
      "default": [],
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "tasks": {
      "default": [],
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-_]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "program": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "args": {
            "default": [],
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 1024
            }
          },
          "cwd": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "required": [
          "id",
          "title",
          "program",
          "args"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "exclude",
    "tasks"
  ],
  "additionalProperties": false
}
